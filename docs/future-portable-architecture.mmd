        F3["ports<br/>display / input / storage / network / power / clock"]
        F4["infra<br/>manifest / config / fscompat / errors"]
    end

    subgraph PRODUCTS["products"]
        P1["products/calsci/domain<br/>calc / graph / matrix / latex"]
